rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /recipes/{recipeId} {
      // Anyone with the app open (anonymous sign-in happens automatically)
      // can read and write. This keeps things frictionless for family use
      // while blocking drive-by bots that never load the page.
      allow read, write: if request.auth != null;
    }

    match /meta/{docId} {
      // meta/roster (known names) and meta/categories (admin-created
      // categories) — same low-friction model as recipes. Anyone signed in
      // (anonymously) can read and write. Without this block, Firestore's
      // default-deny rule silently blocked every write here: registering
      // your name in the roster, and admins creating new categories.
      allow read, write: if request.auth != null;
    }

    match /mealplans/{uid} {
      // Meal plans are private per-device: only the anonymous auth UID that
      // owns a given mealplans/{uid} document may read or write it. This
      // was already the documented design ("private per-device, enforced by
      // real Firestore rules on auth.uid") but the rule itself was never
      // actually written — without it, every meal-plan save failed silently.
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
